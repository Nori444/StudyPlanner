digraph G {
  rankdir=TB; fontname="Inter"; nodesep=0.6; ranksep=0.8; pad=0.3; compound=true;
  node [fontname="Inter", fontsize=12, style="filled,rounded", shape=box, color="#5265c9", fillcolor="#eef0ff", margin="0.22,0.14"];
  edge [fontname="Inter", fontsize=10.5, color="#535c73", arrowsize=0.8];

  subgraph cluster_dev { label="Пристрій студента (межа довіри: дані не залишають пристрій)"; labeljust=l; fontsize=12; style="dashed,rounded"; color="#2f9e63"; fontcolor="#1f7a4a"; margin=20;
    browser [label="Веб-браузер\nHTML + CSS + JavaScript\n(UI, Task Service, Storage Adapter)", fillcolor="#dfe4ff"];
    ls [label="localStorage\nключ studyplanner.tasks.v1", fillcolor="#e8f6ee", color="#2f9e63"];
    browser -> ls [label="читання / запис\nJSON"];
  }
  subgraph cluster_host { label="Хостинг статичних файлів"; labeljust=l; fontsize=12; style="dashed,rounded"; color="#c79a1e"; fontcolor="#8a6a10"; margin=20;
    pages [label="GitHub Pages\nindex.html, style.css, app.js", fillcolor="#fff4d6", color="#c79a1e"];
  }
  repo [label="GitHub-репозиторій\nStudyPlanner (код + docs/)", fillcolor="#f3f3f3", color="#999999"];

  pages -> browser [label="HTTPS GET\n(лише статичні файли)"];
  repo -> pages [label="публікація з гілки main"];
}
